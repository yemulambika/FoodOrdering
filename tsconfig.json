{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*", "./src/*"],
      "@components/*": ["./src/components/*", "./components/*"],
      "@assets/*": ["./assets/*"],
      "@api/*": ["./src/api/*", "./api/*"],
      "@lib/*": ["./src/lib/*", "./lib/*"],
      "@providers/*": ["./src/providers/*", "./providers/*"],
      "@constants/*": ["./src/constants/*", "./constants/*"],
      "@types": ["./src/types.ts", "./types.ts"],
      "@types/*": ["./src/types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase"
  ]
}
