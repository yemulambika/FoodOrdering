# Copy this file to .env (or set the variables in your environment)
# Replace the placeholders with your project's values

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional local secrets used in some workflows
EXPO_DB_PASSWORD=your_local_db_password
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Usage:
# 1. Copy to .env:  cp .env.example .env
# 2. Restart Expo: npx expo start -c
# (After copying, fill the placeholders above and restart Expo)
